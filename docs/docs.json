{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "While",
  "description": "The whileai Python SDK: a scientific post-training library for language models. SFT and RL on open models, with the measurement that says whether training helped.",
  "colors": {
    "primary": "#3F8F6B",
    "light": "#5CB08A",
    "dark": "#3F8F6B"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://withwhile.com"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B1220"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "vitesse-dark"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Search calls, knobs and guides"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "vscode"
    ]
  },
  "markdown": {
    "instructions": [
      "Install with `uv add whileai`; import as `import whileai as wai`.",
      "Run the offline path first (`simulator=False`, `wai.seeded_agent`, a callable judge); no key is needed for it.",
      "Report every pass rate with its interval and n, as `scored.pass_at` prints it."
    ]
  },
