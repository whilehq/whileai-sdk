# helpers, not the product
/scripts/*
!/scripts/check_no_hardcoding.py
# ...and the old-name ratchet with its baseline: CI lint runs it on every PR.
!/scripts/check_old_name.py
!/scripts/old_name_baseline.json
# ...and the hosted-defaults gate with its manifest of deployed Modal apps: CI
# lint runs it on every PR so a default cannot go on naming a stopped app.
!/scripts/check_hosted_defaults.py
!/scripts/hosted_defaults_manifest.json
# ...except the golden-output harness, which every contributor needs to prove
# an engine change left simulate() alone. See CONTRIBUTING.md.
!/scripts/golden.py
# ...and the rename script, so an open branch can regenerate the rebrand.
!/scripts/rebrand.py
# ...and the API reference generator: CI runs it with --check on every PR.
!/scripts/gen_api_docs.py
!/scripts/gen_recipe_docs.py
# ...and the guide figures generator: docs/figures/*.svg are its output.
!/scripts/gen_guide_figures.py
# ...and the docs snippet runner, with the per-page fixtures it needs: CI runs
# it on every PR so a code block on the site cannot rot.
!/scripts/check_doc_snippets.py
!/scripts/doc_snippets/
!/scripts/doc_snippets/*.py
simulate.ipynb
test.ipynb
quick_tests.ipynb
whileai/simulations/_experimental/

# editor config and local notes
.cursor/
# transient agent worktrees; .claude/ itself stays committable for project config
.claude/worktrees/
AUDIT_*.md
dist/
build/

# downloaded wheels, not the product
wheels/

recipes/04-train/text-to-sql/serve_config.json
!scripts/skill_trial.py

