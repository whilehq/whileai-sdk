{
  "recipe": "04-train/parsebench",
  "entry": "while.ai",
  "benchmark": {
    "name": "ParseBench",
    "arxiv": "2604.08538",
    "dataset": "llamaindex/ParseBench",
    "overall": "mean of five dimension scores: tables (avg_grits_trm_composite), charts (avg_rule_pass_rate), text content (avg_content_faithfulness), text formatting (avg_semantic_formatting), layout (avg_layout_element_rule_pass_rate), each x100"
  },
  "model": "Qwen/Qwen3.8-27B",
  "layout_detector": "PaddlePaddle/PP-DocLayoutV3_safetensors",
  "headline_pipeline": "wai_agent_v4",
  "split": {
    "code": "waiparse/split.py",
    "rule": "sha1 of the source report name (page suffix _pN stripped) mod 5 == 0 -> dev, else test; every page of a report lands on one side",
    "tuned_on": "dev",
    "reported_on": ["test", "full"],
    "trained_on_parsebench": false
  },
  "interval": {
    "level": 0.95,
    "method": "percentile bootstrap over documents; each dimension resampled independently; Overall = mean of the five resampled dimension means; paired rows resample per-document differences on documents both runs scored",
    "draws": 2000,
    "seed": 0,
    "code": "modal run serve/bench.py::bands --specs <pipeline:split,...> --pairs <a:split|b:split,...>",
    "note": "one RNG is shared across the specs of a call, so the order of --specs moves the bounds in the second decimal"
  },
  "runs": [
